{
  "name": "youtube-hello-extension",
  "version": "1.0.0",
  "description": "YouTube字幕をAIで要約するChrome拡張機能",
  "scripts": {
    "prebuild": "node scripts/sync-version.cjs",
    "predev": "node scripts/sync-version.cjs",
    "pretest": "node scripts/sync-version.cjs",
    "sync-version": "node scripts/sync-version.cjs",
    "test": "jest --coverage",
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "https://www.youtube.com/watch?v=test"
    },
    "setupFiles": [
      "<rootDir>/tests/jest.setup.cjs"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!marked|dompurify)"
    ],
    "moduleNameMapper": {
      "\\.(css|less)$": "<rootDir>/tests/__mocks__/styleMock.js"
    },
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 85,
        "lines": 88,
        "statements": 88
      }
    }
  },
  "devDependencies": {
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/preset-env": "^7.29.7",
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^18.0.9"
  }
}
